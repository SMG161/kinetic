# Copy to .env. Values here match docker-compose.yml and are for local development only.
KINETIC_DATABASE_URL=postgresql+psycopg://kinetic:kinetic@localhost:5433/kinetic

# Must be at least 32 characters. This one is for local development only; anywhere else, generate your own:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
KINETIC_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
